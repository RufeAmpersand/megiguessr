{
	"task.allowAutomaticTasks": "on",
	"task.saveBeforeRun": "always",
	"editor.formatOnSave": true,
	"editor.formatOnType": true,
	"files.autoSave": "afterDelay",
	"files.autoSaveDelay": 10000,
	"files.exclude": {
		"**/*.rpyc": true,
		"**/*.rpa": true,
		"**/*.rpymc": true,
		"**/cache/": true
	},
}